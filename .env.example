# =============================================================================
# vpnUP — Environment Configuration Template
# =============================================================================
# This file is the canonical source of all configurable parameters.
# setup.py reads this template, prompts for values, and writes the final .env.
#
# WARNING: .env contains secrets. It is git-ignored. Never commit .env.
# =============================================================================

# ---- Core -------------------------------------------------------------------
VPN_HOST={{VPN_HOST}}
  # Public IPv4 address or resolvable domain name of the VPS.

VPN_PROTOCOL={{VPN_PROTOCOL}}
  # Selected protocol: wireguard | vless-reality | hysteria2 | tuic

# ---- Admin Credentials (shared across all protocols) ------------------------
ADMIN_USERNAME={{ADMIN_USERNAME}}
  # Web UI login username. Default: admin

ADMIN_PASSWORD={{ADMIN_PASSWORD}}
  # Web UI login password. Auto-generated if left blank during setup.

# ---- WireGuard (ghcr.io/wg-easy/wg-easy) ------------------------------------
WG_PORT={{WG_PORT}}
  # WireGuard UDP listen port.           Default: 51820

WG_UI_PORT={{WG_UI_PORT}}
  # Management Web UI port (HTTP).       Default: 51821

WG_DEFAULT_DNS={{WG_DEFAULT_DNS}}
  # Comma-separated DNS servers for clients. Default: 1.1.1.1,1.0.0.1

WG_ALLOWED_IPS={{WG_ALLOWED_IPS}}
  # Allowed IPs for VPN clients.         Default: 0.0.0.0/0

WG_MTU={{WG_MTU}}
  # MTU for WireGuard interface.         Default: 1420

# ---- VLESS + Reality (ghcr.io/azumi67/3x-ui) --------------------------------
XUI_PORT={{XUI_PORT}}
  # 3x-ui management panel port (HTTP).  Default: 2053

VLESS_PORT={{VLESS_PORT}}
  # VLESS inbound port.                  Default: 443

REALITY_DEST={{REALITY_DEST}}
  # Reality fallback destination (domain:port). Default: www.microsoft.com:443

REALITY_SERVER_NAMES={{REALITY_SERVER_NAMES}}
  # Comma-separated SNI allow-list.      Default: www.microsoft.com,www.google.com

REALITY_PRIVATE_KEY={{REALITY_PRIVATE_KEY}}
  # Reality x25519 private key. Auto-generated if blank.

REALITY_PUBLIC_KEY={{REALITY_PUBLIC_KEY}}
  # Reality x25519 public key. Auto-generated if blank.

REALITY_SHORT_ID={{REALITY_SHORT_ID}}
  # Reality shortId (hex). Auto-generated if blank.

# ---- Hysteria2 (toxxic/hysteria2) -------------------------------------------
HYSTERIA_PORT={{HYSTERIA_PORT}}
  # Hysteria2 UDP listen port.           Default: 8443

HYSTERIA_UI_PORT={{HYSTERIA_UI_PORT}}
  # Management Web UI port (HTTP).       Default: 8080

HYSTERIA_OBFS={{HYSTERIA_OBFS}}
  # Obfuscation password. Auto-generated if blank.

HYSTERIA_CERT_DOMAIN={{HYSTERIA_CERT_DOMAIN}}
  # Domain for ACME certificate. Uses self-signed if blank.

# ---- TUIC -------------------------------------------------------------------
TUIC_PORT={{TUIC_PORT}}
  # TUIC QUIC listen port.               Default: 8443

TUIC_UI_PORT={{TUIC_UI_PORT}}
  # Management Web UI port (HTTP).       Default: 8080

TUIC_CERT_DOMAIN={{TUIC_CERT_DOMAIN}}
  # Domain for ACME certificate. Uses self-signed if blank.

TUIC_UUID={{TUIC_UUID}}
  # TUIC user UUID. Auto-generated if blank.

TUIC_PASSWORD={{TUIC_PASSWORD}}
  # TUIC user password. Auto-generated if blank.
